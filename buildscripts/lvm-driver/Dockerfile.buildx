# Build stages run natively and cross-build for the target: emulating them under QEMU is very slow.
FROM --platform=$BUILDPLATFORM golang:1.26.9-alpine AS build

ARG BRANCH
ARG RELEASE_TAG
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT=""

ENV GO111MODULE=on \
  GOOS=${TARGETOS} \
  GOARCH=${TARGETARCH} \
  GOARM=${TARGETVARIANT} \
  DEBIAN_FRONTEND=noninteractive \
  PATH="/root/go/bin:${PATH}" \
  BRANCH=${BRANCH} \
  RELEASE_TAG=${RELEASE_TAG}

WORKDIR /go/src/github.com/openebs/lvm-localpv/

RUN apk add make git bash gcc musl-dev

COPY go.mod go.sum ./
# Get dependencies - will also be cached if we won't change mod/sum
RUN go mod download

COPY . .

RUN make buildx.csi-driver

FROM registry.access.redhat.com/ubi9/ubi-micro:9.9@sha256:dbd325b96bcd432dd42816d31412bdf1dc0fb973b79ed310344bc23c76c068db AS micro

# ubi-micro has no package manager: install into a copy of it from ubi, then copy it back over.
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/ubi:9.9@sha256:e45746866f611d164042b961cd83f1093c4fdb422d9b99fcf23ff951626044f8 AS rootfs
ARG TARGETARCH
COPY --from=micro / /rootfs
COPY buildscripts/lvm-driver/almalinux.repo /etc/yum.repos.d/
# The removed packages are only pulled in via systemd/pam and are never used by the driver.
RUN arch=$(case "$TARGETARCH" in amd64) echo x86_64;; arm64) echo aarch64;; *) echo "$TARGETARCH";; esac) \
 && dnf -y -q --installroot /rootfs --forcearch "$arch" --setopt reposdir=/etc/yum.repos.d --setopt install_weak_deps=0 --nodocs install \
      lvm2 device-mapper util-linux ca-certificates xfsprogs e2fsprogs btrfs-progs openssl-fips-provider \
 && rpm --root /rootfs -e --nodeps --noscripts systemd systemd-pam systemd-rpm-macros dbus dbus-broker dbus-common \
      pam libpwquality cracklib cracklib-dicts shadow-utils libsemanage libdb \
 && rm -f /rootfs/usr/bin/login /rootfs/usr/bin/su /rootfs/usr/sbin/runuser \
 && dnf -q --installroot /rootfs clean all

# No udevd in the pod: LVM must create /dev nodes itself and see all host devices.
# Monitoring off: thin pool autoextend is left to the host's dmeventd and lvm.conf.
RUN printf 'devices {\n\tuse_devicesfile = 0\n}\nactivation {\n\tudev_sync = 0\n\tudev_rules = 0\n\tmonitoring = 0\n}\n' > /rootfs/etc/lvm/lvmlocal.conf

# Load only the FIPS (+ base) provider, so non-FIPS algorithms can't be fetched even explicitly.
RUN sed -i -e 's/^default = default_sect$/fips = fips_sect\nbase = base_sect/' \
      -e 's/^\[default_sect\]$/[fips_sect]\nactivate = 1\n\n[base_sect]/' \
      -e 's/^\[ evp_properties \]$/&\ndefault_properties = fips=yes/' /rootfs/etc/pki/tls/openssl.cnf

FROM micro
COPY --from=rootfs /rootfs /
ENV OPENSSL_FORCE_FIPS_MODE=1

ARG DBUILD_DATE
ARG DBUILD_REPO_URL
ARG DBUILD_SITE_URL
ARG RELEASE_TAG

COPY LICENSE /licenses/
COPY --from=build /go/src/github.com/openebs/lvm-localpv/bin/lvm-driver/lvm-driver /usr/local/bin/lvm-driver

# Labels required by Red Hat (OpenShift) container certification.
LABEL name="openebs/lvm-driver" \
      vendor="OpenEBS" \
      maintainer="OpenEBS Maintainers" \
      version="${RELEASE_TAG:-develop}" \
      release="${RELEASE_TAG:-develop}" \
      summary="OpenEBS LVM LocalPV CSI Driver" \
      description="CSI driver that provisions local persistent volumes from LVM volume groups" \
      url="${DBUILD_SITE_URL}" \
      io.k8s.display-name="OpenEBS LVM LocalPV Driver" \
      io.k8s.description="CSI driver that provisions local persistent volumes from LVM volume groups"
LABEL org.label-schema.name="lvm-driver"
LABEL org.label-schema.description="OpenEBS LVM LocalPV Driver"
LABEL org.label-schema.schema-version="1.0"
LABEL org.label-schema.build-date=$DBUILD_DATE
LABEL org.label-schema.vcs-url=$DBUILD_REPO_URL
LABEL org.label-schema.url=$DBUILD_SITE_URL

ENTRYPOINT ["/usr/local/bin/lvm-driver"]
EXPOSE 7676
